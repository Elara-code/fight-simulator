# 复制成 .env 后填入你的 DeepSeek key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 可选：覆盖默认模型 / 端点 / 端口
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PORT=8787

# 可选：CORS 白名单，多域名逗号分隔（默认只放本地 5173）
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# 可选：滥用保护
# 单 IP 每分钟生成次数上限（默认 10）
# PER_IP_PER_MINUTE=10
# 全局每日生成总次数上限（默认 1000，防止 DeepSeek 账单爆表）
# DAILY_LIMIT=1000

# 可选：观测
# 后端错误上报（Sentry DSN）
# SENTRY_DSN=
# 前端错误上报（浏览器暴露，Vite 前缀 VITE_）
# VITE_SENTRY_DSN=

# 可选：PostHog 产品分析（免费版 1M events/mo）
# 从 https://app.posthog.com 建项目后复制 Project API Key
# VITE_POSTHOG_KEY=
# 区域：美国用默认、欧盟用 https://eu.i.posthog.com、自托管填自己域名
# VITE_POSTHOG_HOST=https://us.i.posthog.com
